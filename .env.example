# Copy to .env.local for local builds, or set as EAS environment variables
# (`eas env:create`) for cloud builds. Never commit real values.

# --- App identity ---
APP_BUNDLE_ID=com.abdullahtammar.lumo
EAS_PROJECT_ID=

# --- AdMob app ids (build time, from AdMob > Apps > App settings) ---
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# --- AdMob ad units (runtime). Dev builds always use Google test ads. ---
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=

# --- RevenueCat public SDK keys (Project settings > API keys) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Legal / support (required by both stores) ---
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
